<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Salt Lamp Almanac</title>
<style>
:root{
  --stage:#e4ddd0; --ink:#2a2420; --muted:#7a6d60; --paper:#f6f0e2; --paper2:#efe6d3;
  --cover:#1f3a3d; --cover2:#142628; --gold:#d9b66a; --btn:#2a2420; --btnfg:#f6f0e2;
  --w:clamp(140px,min(46vw,calc((100dvh - 170px)/1.42)),380px);
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--stage:#171513;--ink:#2a2420;--muted:#7a6d60;--btn:#d9b66a;--btnfg:#171513}}
:root[data-theme="dark"]{--stage:#171513;--btn:#d9b66a;--btnfg:#171513}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--stage);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;font-family:Georgia,"Times New Roman",serif;overflow-x:hidden}
.stage{perspective:2400px;width:100%;display:flex;justify-content:center;padding:10px 0}
.book{position:relative;width:var(--w);height:calc(var(--w)*1.42);transform-style:preserve-3d;transition:transform .9s cubic-bezier(.65,.05,.25,1);transform:translateX(0)}
.book.open{transform:translateX(calc(var(--w)/2))}
.book.end{transform:translateX(var(--w))}
.book::before{content:"";position:absolute;inset:3% -2% -3% -102%;background:rgba(0,0,0,.28);filter:blur(18px);transform:translateZ(-30px);opacity:0;transition:opacity .9s}
.book.open::before{opacity:1}
.leaf{position:absolute;inset:0;transform-origin:left center;transform-style:preserve-3d;transition:transform 1s cubic-bezier(.55,.08,.25,1);cursor:pointer}
.leaf.flipped{transform:rotateY(-180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden;background:var(--paper);color:var(--ink);padding:9% 9% 8%;font-size:calc(var(--w)/21);line-height:1.5;display:flex;flex-direction:column}
.front{border-radius:0 6px 6px 0;box-shadow:inset 10px 0 14px -10px rgba(0,0,0,.35),inset -2px 0 0 var(--paper2)}
.back{transform:rotateY(180deg);border-radius:6px 0 0 6px;box-shadow:inset -10px 0 14px -10px rgba(0,0,0,.35),inset 2px 0 0 var(--paper2)}
.leaf.flipped .front,.leaf:not(.flipped) .back{pointer-events:none}
.cover,.end-face{flex:1;position:relative;display:flex;flex-direction:column}
.cover{background:linear-gradient(135deg,var(--cover),var(--cover2));color:var(--gold);align-items:center;justify-content:center;text-align:center;border:calc(var(--w)/38) solid var(--cover2);box-shadow:inset 0 0 0 1px var(--gold)}
.cover h1{font-size:2em;line-height:1.1;margin:.4em 0;font-weight:400;letter-spacing:.02em}
.cover p{margin:0;opacity:.85;font-style:italic}
.cover .rule{width:40%;height:1px;background:var(--gold);margin:.6em auto;opacity:.7}
.cover .hint{position:absolute;bottom:7%;font-size:.8em;opacity:.7}
h2{font-size:1.45em;font-weight:400;margin:0 0 .6em;line-height:1.2}
h3{font-size:.8em;font-weight:400;font-style:italic;color:var(--muted);margin:0 0 .3em}
p{margin:0 0 .7em;hyphens:auto;text-align:justify}
.drop::first-letter{float:left;font-size:2.8em;line-height:.85;padding:.05em .08em 0 0;color:var(--cover)}
.num{margin-top:auto;text-align:center;font-size:.8em;color:var(--muted)}
.toc{list-style:none;margin:0;padding:0}
.toc li{margin:0 0 .55em}
.toc a{display:flex;align-items:baseline;gap:.4em;color:inherit;text-decoration:none;cursor:pointer}
.toc a:hover .t,.toc a:focus-visible .t{color:var(--cover);text-decoration:underline}
.toc a:focus-visible{outline:2px solid var(--cover);outline-offset:2px}
.toc .dots{flex:1;border-bottom:1px dotted var(--muted);transform:translateY(-.25em)}
.toc .pn{color:var(--muted)}
.end-face{background:linear-gradient(225deg,var(--cover),var(--cover2));color:var(--gold);align-items:center;justify-content:center;text-align:center;font-style:italic}
.bar{display:flex;align-items:center;gap:14px;color:var(--muted);font-size:14px}
.bar button{font:inherit;background:var(--btn);color:var(--btnfg);border:0;border-radius:999px;padding:9px 18px;cursor:pointer}
.bar button:disabled{opacity:.35;cursor:default}
.bar button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
#status{min-width:110px;text-align:center}
@media (max-width:600px){.face{font-size:calc(var(--w)/17);line-height:1.4}}
@media (prefers-reduced-motion:reduce){.book,.leaf{transition-duration:.01s}}
</style>
</head>
<body>
<div class="stage"><div class="book" id="book" role="group" aria-label="Book"></div></div>
<div class="bar">
  <button id="prev" type="button">Previous</button>
  <span id="status" aria-live="polite"></span>
  <button id="next" type="button">Next</button>
</div>
<script>
(function(){
  var toc=[["Introduction",1,"Introduction"],["I. The Lamp in the Window",2,"1"],["II. A Map of Small Harbors",2,"2"],["III. What the Tide Keeps",3,"3"],["IV. Morning, Again",3,"4"]];
  var sides=[
    '<div class="cover"><div class="rule"></div><h1>The Salt Lamp<br>Almanac</h1><div class="rule"></div><p>Notes from a quiet coast</p><span class="hint">Tap to open</span></div>',
    '<h3>Foreword</h3><h2>Introduction</h2><p class="drop">This almanac was kept by lamplight over one long autumn. It gathers four short essays on harbors, weather, and the habit of paying attention.</p><p>Read it in order, or open the contents and wander. Every page turns both ways.</p><div class="num">i</div>',
    '<h2>Contents</h2><ul class="toc" id="toc"></ul><div class="num">ii</div>',
    '<h3>Chapter I</h3><h2>The Lamp in the Window</h2><p class="drop">Every harbor town has one window that stays lit. Nobody remembers who first left the lamp burning, only that the boats came home to it.</p><div class="num">1</div>',
    '<h3>Chapter II</h3><h2>A Map of Small Harbors</h2><p class="drop">The best maps leave things out. Mine marks only the jetties where the water stays calm and the coffee is still hot at dawn.</p><div class="num">2</div>',
    '<h3>Chapter III</h3><h2>What the Tide Keeps</h2><p class="drop">The tide returns what it borrows, mostly. Glass, rope, a single blue glove. The rest it keeps, and we learn not to ask.</p><div class="num">3</div>',
    '<h3>Chapter IV</h3><h2>Morning, Again</h2><p class="drop">Fog lifts the way a page turns: slowly, then all at once. The lamp goes out, and the day is already written.</p><div class="num">4</div>',
    '<div class="end-face"><p style="text-align:center;font-size:1.3em;margin:0">Fin.</p><p style="text-align:center;margin:.6em 0 0;opacity:.8">Thank you for reading.</p></div>'
  ];
  var book=document.getElementById('book'),leaves=[],flipped=[],N=sides.length/2,p=0;
  for(var i=0;i<N;i++){
    var l=document.createElement('div');l.className='leaf';
    l.innerHTML='<div class="face front">'+sides[2*i]+'</div><div class="face back">'+sides[2*i+1]+'</div>';
    if(i===0)l.querySelector('.front').style.padding='0';
    if(i===N-1)l.querySelector('.back').style.padding='0';
    book.appendChild(l);leaves.push(l);flipped.push(false);
    (function(idx){l.addEventListener('click',function(e){if(e.target.closest('a'))return;setP(flipped[idx]?idx:idx+1)})})(i);
  }
  var firstFront=leaves[0].querySelector('.front');firstFront.style.background='none';
  function z(i){return flipped[i]?i+1:N-i}
  leaves.forEach(function(l,i){l.style.zIndex=z(i)});
  var t=document.getElementById('toc');
  toc.forEach(function(it){
    var li=document.createElement('li'),a=document.createElement('a');
    a.tabIndex=0;a.setAttribute('role','link');
    a.innerHTML='<span class="t">'+it[0]+'</span><span class="dots"></span><span class="pn">'+it[2]+'</span>';
    function go(e){e.stopPropagation();setP(it[1])}
    a.addEventListener('click',go);
    a.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();go(e)}});
    li.appendChild(a);t.appendChild(li);
  });
  function setP(n){
    n=Math.max(0,Math.min(N,n));if(n===p)return;
    var up=n>p,from=p,k=0;p=n;
    var range=[];
    if(up)for(var i=from;i<n;i++)range.push(i);else for(var j=from-1;j>=n;j--)range.push(j);
    range.forEach(function(i){
      setTimeout(function(){
        leaves[i].style.zIndex=60;
        flipped[i]=up;
        leaves[i].classList.toggle('flipped',up);
        setTimeout(function(){leaves[i].style.zIndex=z(i)},520);
      },k*140);k++;
    });
    book.classList.toggle('open',p>0&&p<N);
    book.classList.toggle('end',p===N);
    update();
  }
  function update(){
    document.getElementById('prev').disabled=p===0;
    document.getElementById('next').disabled=p===N;
    document.getElementById('status').textContent=p===0?'Cover':p===N?'The end':'Spread '+p+' of '+(N-1);
  }
  document.getElementById('prev').onclick=function(){setP(p-1)};
  document.getElementById('next').onclick=function(){setP(p+1)};
  document.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight')setP(p+1);else if(e.key==='ArrowLeft')setP(p-1);
  });
  var sx=null;
  book.addEventListener('touchstart',function(e){sx=e.touches[0].clientX},{passive:true});
  book.addEventListener('touchend',function(e){
    if(sx===null)return;var dx=e.changedTouches[0].clientX-sx;sx=null;
    if(Math.abs(dx)>50){setP(dx<0?p+1:p-1)}
  },{passive:true});
  update();
})();
</script>
</body>
</html>
